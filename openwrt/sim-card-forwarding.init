#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/python3
SCRIPT=/usr/libexec/sim-card-forwarding/mf833u1_forwarder.py
CONFIG_DIR=/etc/sim-card-forwarding/instances.d
CREDENTIALS_DIR=/etc/sim-card-forwarding/credentials.d
STATE_DIR=/overlay/sim-card-forwarding/state-data
INBOX_SNAPSHOT=/overlay/sim-card-forwarding/inbox-view/inbox.sqlite3

start_service() {
	[ -x "$PROG" ] || {
		logger -t sim-card-forwarding "python3 is not installed"
		return 1
	}
	[ -f "$SCRIPT" ] || {
		logger -t sim-card-forwarding "forwarder script is missing"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" "$SCRIPT"
	procd_append_param command --config-dir "$CONFIG_DIR"
	procd_append_param command --credentials-dir "$CREDENTIALS_DIR"
	procd_append_param command --auto-unlock
	procd_append_param command --state-dir "$STATE_DIR"
	procd_append_param command --inbox-snapshot "$INBOX_SNAPSHOT"
	procd_append_param command --interval 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sim-card-forwarding
}
